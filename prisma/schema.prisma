// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  FLAGGED
  BANNED
}
enum PostSatus{
  GOOD
  FLAGGED
}


model User {
  id               Int          @id @default(autoincrement())
  email            String       @unique
  name             String?    
  avatarUrl        String?
  username         String       @unique
  password         String       
  role             Role         @default(USER)
  status           UserStatus   @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  posts            Post[]
  comments         Comment[]
  folders          Folder[]
  files            File[]
  
  // 👈 Explicitly name the relation fields here
  SentMessages     Message[]    @relation("SentMessages")
  ReceivedMessages Message[]    @relation("ReceivedMessages")
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  status      PostSatus @default(GOOD)

  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    Int

  files       File[]
  folders     Folder[]

  comments    Comment[]
} 

model Comment {
  id          Int      @id @default(autoincrement())
  content     String
  createdAt   DateTime @default(now())

  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      Int

  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    Int
}


model Folder {
  id          Int      @id @default(autoincrement())
  name        String
  createdAt   DateTime @default(now())
  
  // Links the folder to its owner
  user        User     @relation(fields: [userId], references: [id])
  userId      Int

  posts       Post?    @relation(fields:[postId],references:[id])
  postId      Int
  //Links the folder to ShareLink
  // A folder can contain many files
  files       File[]
}

model File {
  id          Int      @id @default(autoincrement())
  name        String   // The original name of the file (e.g., "vacation.png")
  url         String   // The path or Cloudinary URL where the file is actually stored
  size        Int      // Size of the file in bytes (useful for the project requirements)
  uploadTime DateTime @default(now())

  // Links the file to its owner
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  // Links the file to a specific folder (Optional, in case files are in a "root" directory)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId    Int?

  //link to post 
  posts       Post?   @relation(fields:[postId],references:[id], onDelete: Cascade)
  postId      Int?
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String
  createdAt  DateTime @default(now())
  isRead     Boolean  @default(false)

  // 👈 Match the relation name to the User model arrays
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderId   Int

  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId Int
}